<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework>
  <AssemblyName Condition="'$(LAUNCHER_ASSEMBLY_NAME)' == ''">CinemaGraphApp</AssemblyName>
  <AssemblyName Condition="'$(LAUNCHER_ASSEMBLY_NAME)' != ''">$(LAUNCHER_ASSEMBLY_NAME)</AssemblyName>
  <DefineConstants Condition="'$(VARIANT)' == 'Lite'">$(DefineConstants);UNPRIVILEGED_LITE</DefineConstants>
  <UseAppHost>false</UseAppHost><EnableDefaultCompileItems>false</EnableDefaultCompileItems><DebugType>none</DebugType><ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
  <Optimize>true</Optimize>
  <ServerGarbageCollection>false</ServerGarbageCollection>
  <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  <TieredCompilation>true</TieredCompilation>
  <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
 </PropertyGroup>
 <ItemGroup><Compile Include="Home.cs" /><Compile Include="AppLibrary.cs" /><Compile Include="SettingsStore.cs" /><Compile Include="Localization.cs" /><Compile Include="NativeCapabilities.cs" /><Compile Include="DebugLog.cs" /></ItemGroup>
 <ItemGroup>
  <Reference Include="Tizen.NUI"><HintPath>$(TV_FRAMEWORK_DIR)/Tizen.NUI.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="Tizen.Applications.Common"><HintPath>$(TV_FRAMEWORK_DIR)/Tizen.Applications.Common.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="Tizen.System"><HintPath>$(TV_FRAMEWORK_DIR)/Tizen.System.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="Tizen"><HintPath>$(TV_FRAMEWORK_DIR)/Tizen.dll</HintPath><Private>false</Private></Reference>
 </ItemGroup>
</Project>
